@page "/acceso"
@layout AccesoLayout
@inject SesionService Sesion
@inject InventarioClient Api
@inject NavigationManager Nav

<PageTitle>Acceso · AFRISAN</PageTitle>
<div class="access-shell">
    <section class="access-story">
        <a class="brand" href="acceso"><span class="brand-mark">A</span><span>AFRISAN<small>CONTROL DE REFRIGERANTES</small></span></a>
        <div><span class="eyebrow light">OPERACIÓN DE BODEGA</span><h1>Cada cilindro.<br />Un registro.<br />Toda su historia.</h1><p>Identifica tus envases, registra su refrigerante y consulta el inventario desde un solo lugar.</p></div>
        <footer>Revisión funcional · PN-01 y PN-02</footer>
    </section>
    <section class="access-form">
        <div class="access-card">
            <span class="eyebrow">BIENVENIDO A AFRISAN</span><h2>Iniciar sesión</h2><p class="muted">Accede al inventario con tu perfil de trabajo.</p>
            @if (error is not null) { <div class="notice error" role="alert">@error</div> }
            @if (Sesion.Entorno is { } entorno)
            {
                <div class="demo-access"><strong>Selecciona una cuenta de demostración</strong>
                    <div class="role-buttons">@foreach (var cuenta in entorno.Cuentas)
                        { <button type="button" class="role-button @(form.Email == cuenta.Email ? "selected" : "")" disabled="@ocupado" @onclick="() => Elegir(cuenta)">@(cuenta.Rol == "Tecnico" ? "Técnico" : cuenta.Rol)</button> }
                    </div><small>Solo memoria. Sin cuentas ni registros en Supabase.</small>
                </div>
            }
            else { <div class="notice warning">La API no está disponible. Inicia ambos proyectos y <button class="text-button" @onclick="Recargar">vuelve a conectar</button>.</div> }
            <EditForm Model="form" OnValidSubmit="Ingresar">
                <DataAnnotationsValidator /><ValidationSummary />
                <label for="correo">Correo electrónico</label><InputText id="correo" autocomplete="username" @bind-Value="form.Email" />
                <label for="clave">Contraseña</label><InputText id="clave" type="password" autocomplete="current-password" @bind-Value="form.Password" />
                <button class="btn primary wide" type="submit" disabled="@ocupado">@(ocupado ? "Ingresando…" : "Entrar a AFRISAN →")</button>
            </EditForm>
            <p class="fine-print">Versión de revisión. Los registros de inventario se pierden al reiniciar la API.</p>
        </div>
    </section>
</div>

@code {
    private readonly CredencialesForm form = new();
    private bool ocupado;
    private string? error;
    private void Elegir(CuentaDemoResponse cuenta) { form.Email = cuenta.Email; form.Password = Sesion.Entorno!.PasswordDemo; error = null; }
    private async Task Recargar() { await Sesion.InicializarAsync(); error = Sesion.Entorno is null ? "La API sigue sin responder en http://localhost:5181." : null; }
    private async Task Ingresar()
    {
        if (ocupado) return;
        ocupado = true; error = null;
        try { await Sesion.IngresarAsync(await Api.LoginAsync(new() { Email = form.Email, Password = form.Password })); Nav.NavigateTo(Sesion.Sesion?.Rol is "Tecnico" or "Autorizador" ? "ordenes" : ""); }
        catch (Exception ex) { error = Formato.Error(ex); }
        finally { ocupado = false; }
    }
}
