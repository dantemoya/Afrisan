@page "/gases-refrigerantes"

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "Administrador,Jefatura,Bodega")]

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Gases refrigerantes | AFRISAN</PageTitle>

<div class="container-fluid py-4">

    <!-- =====================================================
         ENCABEZADO PRINCIPAL
         ===================================================== -->

    <div class="p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #102c46, #176b91);">

        <h1 class="fw-bold mb-2">
            Gases refrigerantes
        </h1>

        <p class="mb-0">
            Consulta los tipos de gases refrigerantes utilizados en AFRISAN.
            @if (esAdministrador)
            {
                <span>
                    Puedes registrar, editar y administrar el catálogo.
                </span>
            }
        </p>

    </div>

    <!-- =====================================================
         RESUMEN
         ===================================================== -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <h6 class="text-muted">
                        Total de gases
                    </h6>

                    <h2 class="fw-bold text-primary">
                        @TotalGases
                    </h2>

                    <small class="text-muted">
                        Tipos de gases registrados
                    </small>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <h6 class="text-muted">
                        Gases activos
                    </h6>

                    <h2 class="fw-bold text-success">
                        @GasesActivos
                    </h2>

                    <small class="text-muted">
                        Disponibles para asociar a cilindros
                    </small>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <h6 class="text-muted">
                        Gases inactivos
                    </h6>

                    <h2 class="fw-bold text-secondary">
                        @GasesInactivos
                    </h2>

                    <small class="text-muted">
                        Tipos de gases deshabilitados
                    </small>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
         MENSAJES
         ===================================================== -->

    @if (mensajeExito is not null)
    {
        <div class="alert alert-success mb-4"
             role="status">

            @mensajeExito

        </div>
    }

    @if (errorOperacion is not null)
    {
        <div class="alert alert-danger mb-4"
             role="alert">

            @errorOperacion

        </div>
    }

    <!-- =====================================================
         FORMULARIO
         SOLO ADMINISTRADOR
         ===================================================== -->

    @if (esAdministrador && mostrarFormulario)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white p-4">

                <h4 class="fw-bold mb-1">

                    @(idEditando.HasValue
                        ? "Editar gas refrigerante"
                        : "Registrar nuevo gas refrigerante")

                </h4>

                <p class="text-muted mb-0">

                    @(idEditando.HasValue
                        ? "Modifica la información del gas seleccionado."
                        : "Completa los datos del nuevo refrigerante.")

                </p>

            </div>

            <div class="card-body p-4">

                @if (errorFormulario is not null)
                {
                    <div class="alert alert-danger"
                         role="alert">

                        @errorFormulario

                    </div>
                }

                <div class="row g-3">

                    <!-- NOMBRE -->

                    <div class="col-12 col-md-6">

                        <label class="form-label fw-bold">
                            Nombre del refrigerante *
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Ejemplo: Refrigerante R-404A"
                               maxlength="100"
                               @bind="formulario.Nombre"
                               disabled="@guardando" />

                    </div>

                    <!-- CÓDIGO -->

                    <div class="col-12 col-md-6">

                        <label class="form-label fw-bold">
                            Código del refrigerante *
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Ejemplo: R-404A"
                               maxlength="50"
                               @bind="formulario.Codigo"
                               disabled="@guardando" />

                    </div>

                    <!-- DESCRIPCIÓN -->

                    <div class="col-12">

                        <label class="form-label fw-bold">
                            Descripción
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Escribe una descripción del refrigerante"
                                  @bind="formulario.Descripcion"
                                  disabled="@guardando">
                        </textarea>

                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Factor GWP</label>
                        <input class="form-control" type="number" min="0" step="0.001"
                               @bind="formulario.FactorGwp" disabled="@guardando" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Fuente del GWP</label>
                        <input class="form-control" maxlength="300" @bind="formulario.FuenteGwp"
                               disabled="@guardando" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Metodología del GWP</label>
                        <input class="form-control" maxlength="100" @bind="formulario.MetodologiaGwp"
                               placeholder="Informe y horizonte temporal" disabled="@guardando" />
                    </div>
                    <!-- ESTADO -->

                    <div class="col-12">

                        <div class="form-check form-switch mt-2">

                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="estadoGas"
                                   @bind="formulario.Activo"
                                   disabled="@guardando" />

                            <label class="form-check-label fw-bold"
                                   for="estadoGas">

                                @(formulario.Activo
                                    ? "Activo"
                                    : "Inactivo")

                            </label>

                        </div>

                    </div>

                </div>

                <!-- BOTONES -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@guardando"
                            @onclick="CancelarFormulario">

                        Cancelar

                    </button>

                    <button type="button"
                            class="btn btn-success"
                            disabled="@guardando"
                            @onclick="GuardarGas">

                        @if (guardando)
                        {
                            <span>
                                Guardando...
                            </span>
                        }
                        else
                        {
                            <span>

                                @(idEditando.HasValue
                                    ? "Guardar cambios"
                                    : "Registrar gas")

                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }

    <!-- =====================================================
         INVENTARIO DE GASES
         ===================================================== -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between
                        align-items-center
                        flex-wrap
                        gap-3">

                <div>

                    <h4 class="fw-bold mb-1">
                        Inventario de gases refrigerantes
                    </h4>

                    <p class="text-muted mb-0">

                        @if (esAdministrador)
                        {
                            <span>
                                Consulta y administra los refrigerantes registrados.
                            </span>
                        }
                        else
                        {
                            <span>
                                Consulta de refrigerantes registrados en el sistema.
                            </span>
                        }

                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">

                    @if (esAdministrador)
                    {
                        <button class="btn btn-success"
                                disabled="@(mostrarFormulario || Ocupado)"
                                @onclick="AbrirFormularioNuevo">

                            + Registrar gas

                        </button>
                    }

                    <button class="btn btn-primary"
                            disabled="@Ocupado"
                            @onclick="CargarGases">

                        Actualizar listado

                    </button>

                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <!-- CARGANDO -->

            @if (cargando)
            {
                <div class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">
                    </div>

                    <p class="text-muted mt-3">
                        Cargando gases refrigerantes...
                    </p>

                </div>
            }

            <!-- ERROR -->

            @if (!cargando && error is not null)
            {
                <div class="alert alert-danger"
                     role="alert">

                    <strong>
                        No se pudieron cargar los gases refrigerantes.
                    </strong>

                    <p class="mb-0 mt-2">
                        @error
                    </p>

                </div>
            }

            <!-- VACÍO -->

            @if (!cargando &&
                 error is null &&
                 gases.Count == 0)
            {
                <div class="alert alert-info">

                    No existen gases refrigerantes registrados
                    en el sistema.

                </div>
            }

            <!-- TABLA -->

            @if (!cargando &&
                 error is null &&
                 gases.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Acciones</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var gas in gases)
                            {
                                <tr>

                                    <td>
                                        @gas.Id
                                    </td>

                                    <td>

                                        <strong>
                                            @gas.Nombre
                                        </strong>

                                    </td>

                                    <td>
                                        @gas.Codigo
                                    </td>

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(
                                            gas.Descripcion))
                                        {
                                            <span class="text-muted">
                                                Sin descripción
                                            </span>
                                        }
                                        else
                                        {
                                            @gas.Descripcion
                                        }

                                    </td>

                                    <td>

                                        @if (gas.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (esAdministrador)
                                        {
                                            <div class="d-flex gap-2 flex-wrap">

                                                <button class="btn btn-sm
                                                               btn-outline-primary"
                                                        disabled="@(mostrarFormulario || Ocupado)"
                                                        @onclick="() => AbrirEdicion(gas)">

                                                    Editar

                                                </button>

                                                <button class="btn btn-sm
                                                               btn-outline-danger"
                                                        disabled="@(mostrarFormulario || Ocupado)"
                                                        @onclick="() => SolicitarEliminacion(gas.Id)">

                                                    Eliminar

                                                </button>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Solo lectura
                                            </span>
                                        }

                                    </td>

                                </tr>

                                <!-- CONFIRMACIÓN ELIMINACIÓN -->

                                @if (esAdministrador &&
                                     idPorEliminar == gas.Id)
                                {
                                    <tr>

                                        <td colspan="6">

                                            <div class="alert
                                                        alert-warning
                                                        mb-0">

                                                <strong>

                                                    ¿Eliminar el refrigerante
                                                    @gas.Nombre?

                                                </strong>

                                                <p class="mb-3 mt-2">

                                                    Esta operación eliminará
                                                    el registro del gas
                                                    refrigerante.

                                                    Si existen cilindros
                                                    asociados, la API
                                                    impedirá la eliminación
                                                    para proteger la
                                                    trazabilidad.

                                                </p>

                                                <div class="d-flex gap-2">

                                                    <button class="btn
                                                                   btn-danger
                                                                   btn-sm"
                                                            disabled="@Ocupado"
                                                            @onclick="() => EliminarGas(gas.Id)">

                                                        Confirmar eliminación

                                                    </button>

                                                    <button class="btn
                                                                   btn-secondary
                                                                   btn-sm"
                                                            disabled="@Ocupado"
                                                            @onclick="CancelarEliminacion">

                                                        Cancelar

                                                    </button>

                                                </div>

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- =====================================================
         PIE DE PÁGINA
         ===================================================== -->

    <div class="text-center mt-5 pt-3 border-top">

        <small class="text-muted">

            AFRISAN | Sistema de gestión de refrigerantes

        </small>

    </div>

</div>

@code {

    // =====================================================
    // AUTORIZACIÓN
    // =====================================================

    private bool esAdministrador;


    // =====================================================
    // DATOS
    // =====================================================

    private List<GasRefrigeranteVista> gases =
        new();

    private FormularioGas formulario =
        new();


    // =====================================================
    // ESTADOS
    // =====================================================

    private bool cargando = true;

    private bool guardando;

    private bool mostrarFormulario;

    private int? idEditando;

    private int? idPorEliminar;

    private int? idEliminando;

    private string? error;

    private string? errorFormulario;

    private string? errorOperacion;

    private string? mensajeExito;


    private bool Ocupado =>
        cargando ||
        guardando ||
        idEliminando.HasValue;


    // =====================================================
    // CONTADORES
    // =====================================================

    private string TotalGases =>
        cargando
            ? "..."
            : error is not null
                ? "--"
                : gases.Count.ToString();


    private string GasesActivos =>
        cargando
            ? "..."
            : error is not null
                ? "--"
                : gases.Count(
                    g => g.Activo
                ).ToString();


    private string GasesInactivos =>
        cargando
            ? "..."
            : error is not null
                ? "--"
                : gases.Count(
                    g => !g.Activo
                ).ToString();


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        var estado =
            await AuthStateProvider
                .GetAuthenticationStateAsync();

        esAdministrador =
            estado.User.IsInRole(
                "Administrador");

        await CargarGases();
    }


    // =====================================================
    // CARGAR GASES
    // =====================================================

    private async Task CargarGases()
    {
        cargando = true;

        error = null;

        try
        {
            gases =
                await Http.GetFromJsonAsync<
                    List<GasRefrigeranteVista>>(
                    "api/GasRefrigerantes"
                ) ?? new();
        }
        catch (Exception ex)
        {
            gases = new();

            error =
                "Comprueba que Afrisan.Api esté ejecutándose " +
                "y que la conexión con el servidor funcione.";

            Console.WriteLine(ex);
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // NUEVO GAS
    // SOLO ADMINISTRADOR
    // =====================================================

    private void AbrirFormularioNuevo()
    {
        if (!esAdministrador)
        {
            return;
        }

        idEditando = null;

        idPorEliminar = null;

        errorFormulario = null;

        errorOperacion = null;

        mensajeExito = null;

        formulario =
            new FormularioGas();

        mostrarFormulario = true;
    }


    // =====================================================
    // EDITAR GAS
    // SOLO ADMINISTRADOR
    // =====================================================

    private void AbrirEdicion(
        GasRefrigeranteVista gas)
    {
        if (!esAdministrador)
        {
            return;
        }

        idEditando =
            gas.Id;

        idPorEliminar =
            null;

        errorFormulario =
            null;

        errorOperacion =
            null;

        mensajeExito =
            null;

        formulario =
            new FormularioGas
            {
                Nombre =
                    gas.Nombre,

                Codigo =
                    gas.Codigo,

                Descripcion =
                    gas.Descripcion,

                Activo =
                    gas.Activo,
                FactorGwp = gas.FactorGwp,
                FuenteGwp = gas.FuenteGwp,
                MetodologiaGwp = gas.MetodologiaGwp
            };

        mostrarFormulario = true;
    }


    // =====================================================
    // CANCELAR FORMULARIO
    // =====================================================

    private void CancelarFormulario()
    {
        if (guardando)
        {
            return;
        }

        mostrarFormulario =
            false;

        idEditando =
            null;

        errorFormulario =
            null;

        formulario =
            new FormularioGas();
    }


    // =====================================================
    // GUARDAR GAS
    // POST / PUT
    // SOLO ADMINISTRADOR
    // =====================================================

    private async Task GuardarGas()
    {
        if (!esAdministrador)
        {
            return;
        }

        if (guardando ||
            !mostrarFormulario)
        {
            return;
        }

        errorFormulario = null;

        errorOperacion = null;

        mensajeExito = null;


        formulario.Nombre =
            formulario.Nombre.Trim();

        formulario.Codigo =
            formulario.Codigo
                .Trim()
                .ToUpperInvariant();

        formulario.Descripcion =
            formulario.Descripcion.Trim();


        // -------------------------------------------------
        // VALIDAR NOMBRE
        // -------------------------------------------------

        if (string.IsNullOrWhiteSpace(
            formulario.Nombre))
        {
            errorFormulario =
                "Debes ingresar el nombre del refrigerante.";

            return;
        }


        // -------------------------------------------------
        // VALIDAR CÓDIGO
        // -------------------------------------------------

        if (string.IsNullOrWhiteSpace(
            formulario.Codigo))
        {
            errorFormulario =
                "Debes ingresar el código del refrigerante.";

            return;
        }


        // -------------------------------------------------
        // VALIDAR DUPLICADO EN UI
        // -------------------------------------------------

        var codigoDuplicado =
            gases.Any(g =>
                g.Id != idEditando &&
                string.Equals(
                    g.Codigo,
                    formulario.Codigo,
                    StringComparison.OrdinalIgnoreCase
                )
            );

        if (codigoDuplicado)
        {
            errorFormulario =
                "Ya existe otro refrigerante con ese código.";

            return;
        }


        guardando = true;

        try
        {
            var datos =
                new
                {
                    nombre =
                        formulario.Nombre,

                    codigo =
                        formulario.Codigo,

                    descripcion =
                        formulario.Descripcion,

                    activo =
                        formulario.Activo,
                    factorGwp = formulario.FactorGwp,
                    fuenteGwp = formulario.FuenteGwp,
                    metodologiaGwp = formulario.MetodologiaGwp
                };


            using var respuesta =
                idEditando.HasValue

                    ? await Http.PutAsJsonAsync(
                        $"api/GasRefrigerantes/{idEditando.Value}",
                        datos
                    )

                    : await Http.PostAsJsonAsync(
                        "api/GasRefrigerantes",
                        datos
                    );


            if (!respuesta.IsSuccessStatusCode)
            {
                var detalle =
                    await respuesta.Content
                        .ReadAsStringAsync();

                Console.WriteLine(detalle);

                errorFormulario =
                    $"No se pudo guardar el gas refrigerante. " +
                    $"Código HTTP: {(int)respuesta.StatusCode}.";

                return;
            }


            var eraEdicion =
                idEditando.HasValue;


            mostrarFormulario =
                false;

            idEditando =
                null;

            formulario =
                new FormularioGas();


            mensajeExito =
                eraEdicion
                    ? "El gas refrigerante se actualizó correctamente."
                    : "El gas refrigerante se registró correctamente.";


            await CargarGases();
        }
        catch (Exception ex)
        {
            errorFormulario =
                "Ocurrió un error al guardar el gas refrigerante. " +
                "Comprueba la conexión con la API.";

            Console.WriteLine(ex);
        }
        finally
        {
            guardando = false;
        }
    }


    // =====================================================
    // SOLICITAR ELIMINACIÓN
    // SOLO ADMINISTRADOR
    // =====================================================

    private void SolicitarEliminacion(
        int id)
    {
        if (!esAdministrador)
        {
            return;
        }

        idPorEliminar =
            id;

        errorOperacion =
            null;

        mensajeExito =
            null;
    }


    // =====================================================
    // CANCELAR ELIMINACIÓN
    // =====================================================

    private void CancelarEliminacion()
    {
        if (idEliminando.HasValue)
        {
            return;
        }

        idPorEliminar =
            null;
    }


    // =====================================================
    // ELIMINAR GAS
    // SOLO ADMINISTRADOR
    // =====================================================

    private async Task EliminarGas(
        int id)
    {
        if (!esAdministrador)
        {
            return;
        }

        if (Ocupado ||
            idPorEliminar != id)
        {
            return;
        }

        idEliminando =
            id;

        errorOperacion =
            null;

        mensajeExito =
            null;

        try
        {
            using var respuesta =
                await Http.DeleteAsync(
                    $"api/GasRefrigerantes/{id}"
                );


            if (!respuesta.IsSuccessStatusCode)
            {
                var detalle =
                    await respuesta.Content
                        .ReadAsStringAsync();

                Console.WriteLine(detalle);

                errorOperacion =
                    $"No se pudo eliminar el gas refrigerante. " +
                    $"Código HTTP: {(int)respuesta.StatusCode}. " +
                    "Comprueba que no tenga cilindros asociados.";

                return;
            }


            idPorEliminar =
                null;

            mensajeExito =
                "El gas refrigerante se eliminó correctamente.";


            await CargarGases();
        }
        catch (Exception ex)
        {
            errorOperacion =
                "Ocurrió un error al eliminar el gas refrigerante.";

            Console.WriteLine(ex);
        }
        finally
        {
            idEliminando =
                null;
        }
    }


    // =====================================================
    // MODELO GAS
    // =====================================================

    private sealed class GasRefrigeranteVista
    {
        public int Id { get; set; }

        public string Nombre { get; set; } =
            string.Empty;

        public string Codigo { get; set; } =
            string.Empty;

        public string Descripcion { get; set; } =
            string.Empty;

        public bool Activo { get; set; }
        public decimal? FactorGwp { get; set; }
        public string? FuenteGwp { get; set; }
        public string? MetodologiaGwp { get; set; }
    }


    // =====================================================
    // FORMULARIO
    // =====================================================

    private sealed class FormularioGas
    {
        public string Nombre { get; set; } =
            string.Empty;

        public string Codigo { get; set; } =
            string.Empty;

        public string Descripcion { get; set; } =
            string.Empty;

        public bool Activo { get; set; } =
            true;
        public decimal? FactorGwp { get; set; }
        public string? FuenteGwp { get; set; }
        public string? MetodologiaGwp { get; set; }
    }
}
