@inherits LayoutComponentBase

@using Afrisan.Web.Services

@inject AuthService AuthService
@inject NavigationManager Navigation
@inject EntornoService Entorno

<div class="page">

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>

        <div class="top-row px-4">

            <AuthorizeView>
                <Authorized Context="auth">

                    <div class="d-flex align-items-center gap-3">

                        <div class="text-end">
                            <div>
                                <strong>
                                    @auth.User.Identity?.Name
                                </strong>
                            </div>

                            <small class="text-muted">
                                @ObtenerRol(auth.User)
                            </small>
                        </div>

                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="CerrarSesion">
                            Cerrar sesión
                        </button>

                    </div>

                </Authorized>
            </AuthorizeView>

        </div>

        <article class="content px-4">
            @if (Entorno.Info?.Demo == true)
            {
                <div class="alert alert-warning" role="status">
                    <strong>Modo demostración.</strong> Datos simulados; los cambios se reinician al cerrar la API.
                </div>
            }
            @Body
        </article>

    </main>

</div>

@code {

    private static string ObtenerRol(
        System.Security.Claims.ClaimsPrincipal usuario)
    {
        var rol = usuario.Claims
            .FirstOrDefault(
                c => c.Type ==
                     System.Security.Claims.ClaimTypes.Role)
            ?.Value;

        return rol ?? "Sin rol";
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();

        Navigation.NavigateTo(
            "/login",
            replace: true);
    }
}
